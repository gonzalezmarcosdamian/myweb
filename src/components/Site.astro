    <!-- CONTACT -->
    <section id="contact" class="contact wrap">
      <div class="contact-grid">
        <span class="section-num reveal">/ 04</span>
        <div class="contact-main">
          <h2 class="contact-cta reveal" set:html={t["contact.cta"]}></h2>

          <div class="contact-links reveal">
            <a class="contact-link" href="https://www.linkedin.com/in/marcosdamiangonzalez" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn · /marcosdamiangonzalez">
              <svg class="ico fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 110-4.12 2.06 2.06 0 010 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45C23.21 24 24 23.23 24 22.28V1.72C24 .77 23.21 0 22.22 0z"/></svg>
            </a>
            <a class="contact-link" href="mailto:ingonzalezdamian@gmail.com" aria-label="Email" title="ingonzalezdamian@gmail.com">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </a>
            <a class="contact-link" href="https://wa.me/5492920445362" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
              <svg class="ico fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.18.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.89-.79-1.5-1.78-1.67-2.08-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.11 3.22 5.12 4.51.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.95 9.95 0 01-5.07-1.39l-.36-.21-3.77.99 1.01-3.67-.24-.38a9.9 9.9 0 01-1.52-5.27c0-5.47 4.46-9.91 9.96-9.91 2.66 0 5.16 1.04 7.04 2.92a9.86 9.86 0 012.92 7c0 5.46-4.46 9.91-9.96 9.91zm8.41-18.31a11.83 11.83 0 00-8.41-3.48C5.46-.29.06 5.1.06 11.65c0 2.09.55 4.13 1.59 5.93L0 24l6.6-1.73a11.96 11.96 0 005.43 1.38h.01c6.58 0 11.96-5.39 11.96-11.94 0-3.19-1.24-6.19-3.5-8.45z"/></svg>
