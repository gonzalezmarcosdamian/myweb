  <footer>
    <div>© 2026 · Marcos D. González · <span>{t["footer.built"]}</span></div>
    <div class="clock" id="clock">— · — · —</div>
  </footer>

  <script>
  // ---------- I18N ----------

  const REDUCED_MOTION = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Idioma servido por la ruta (/ = es, /en/ = en). El contenido ya viene
  // renderizado server-side; el cliente no hace swap de texto.
  const currentLang = document.documentElement.lang === "en" ? "en" : "es";

  // ---------- HERO SPARK ----------
  function buildSpark() {
    const W = 300, H = 56, N = 60;
    const pts = [];
    for (let i = 0; i < N; i++) {
      const t = i / (N - 1);
      let v = Math.pow(t, 1.6) * 0.85 + 0.08;
      v += (Math.sin(i * 0.7) * 0.025) + (Math.cos(i * 1.3) * 0.018);
      pts.push(v);
    }
    const max = Math.max(...pts), min = Math.min(...pts);
    const xy = pts.map((v, i) => {
      const x = (i / (N - 1)) * W;
      const y = H - ((v - min) / (max - min)) * (H - 6) - 3;
      return [x, y];
    });
    const linePath = xy.map((p, i) => (i === 0 ? "M" : "L") + p[0].toFixed(1) + " " + p[1].toFixed(1)).join(" ");
    const areaPath = linePath + ` L ${W} ${H} L 0 ${H} Z`;
    document.getElementById("spark-line").setAttribute("d", linePath);
    document.getElementById("spark-area").setAttribute("d", areaPath);
  }
  buildSpark();

  // ---------- SCRAMBLE EFFECT ----------
  const SCRAMBLE_CHARS = "▓░▒█01ABCDEFGHIJKLMNOPQRSTUVWXYZ#$%&";
  function scrambleTo(el, target, duration = 900) {
    cancelAnimationFrame(el._raf);
    const start = performance.now();
    function frame(now) {
      const t = Math.min(1, (now - start) / duration);
      let out = "";
      for (let i = 0; i < target.length; i++) {
        const reveal = i / target.length;
        if (t > reveal + 0.15) {
          out += target[i];
        } else {
          out += SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
        }
      }
      el.textContent = out;
      if (t < 1) el._raf = requestAnimationFrame(frame);
      else el.textContent = target;
    }
    el._raf = requestAnimationFrame(frame);
  }

  /** @type {number | null} */
  let scrambleInterval = null;
  function setupScramble() {
    if (scrambleInterval) clearInterval(scrambleInterval);
    const el = document.querySelector(".scramble");
    if (!el) return;
    const words = el.getAttribute("data-words-" + currentLang).split("|");
    if (REDUCED_MOTION) { el.textContent = words[0]; return; }
    let idx = 0;
    scrambleTo(el, words[0], 700);
    scrambleInterval = setInterval(() => {
      idx = (idx + 1) % words.length;
      scrambleTo(el, words[idx], 900);
    }, 4200);
  }

  // ---------- REVEAL ON SCROLL ----------
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add("in");
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
  document.querySelectorAll(".reveal").forEach(el => io.observe(el));

  function onScroll() {
    const panel = document.getElementById("hero-panel");
    if (panel) panel.style.transform = `translateY(${(window.scrollY * 0.08).toFixed(1)}px)`;
  }
  let ticking = false;
  window.addEventListener("scroll", () => {
    if (!ticking) {
      requestAnimationFrame(() => { onScroll(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });

  // ---------- LIVE CLOCK ----------
  function tick() {
    const d = new Date();
    const timeOpts = { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, timeZone: "America/Argentina/Buenos_Aires" };
    const dateOpts = { day: "2-digit", month: "short", year: "numeric" };
    const locale = currentLang === "en" ? "en-GB" : "es-AR";
    const time = d.toLocaleTimeString(locale, timeOpts);
    const date = d.toLocaleDateString(locale, dateOpts);
    const cl = document.getElementById("clock");
    if (cl) cl.textContent = `${date} · ${time} · BUE`;
  }
  /** @type {number | null} */
  let clockTimer = setInterval(tick, 1000);
  tick();

  function updateUpdated() {
    const d = new Date();
    const locale = currentLang === "en" ? "en-GB" : "es-AR";
    const fmt = d.toLocaleDateString(locale, { day: "2-digit", month: "short", year: "numeric" });
    const el = document.getElementById("now-updated");
    if (el) el.textContent = fmt.toLowerCase();
  }

  // ---------- INIT ----------
  setupScramble();
  updateUpdated();

  // Skill meta flicker on hover
  document.querySelectorAll(".skill-meta b").forEach(b => {
    const orig = b.textContent;
    b.parentElement.addEventListener("mouseenter", () => {
      let count = 0;
      const it = setInterval(() => {
        b.textContent = String(Math.floor(Math.random() * 99)).padStart(2, "0");
        if (++count > 6) { clearInterval(it); b.textContent = orig; }
      }, 50);
    });
  });

  // Easter egg: type "claude"
  let buf = "";
  window.addEventListener("keydown", (e) => {
    buf = (buf + e.key.toLowerCase()).slice(-6);
    if (buf === "claude") {
      document.documentElement.style.setProperty("--accent", "#FF6B35");
      document.documentElement.style.setProperty("--accent-dim", "#a14820");
      setTimeout(() => {
        document.documentElement.style.setProperty("--accent", "#76CE6B");
        document.documentElement.style.setProperty("--accent-dim", "#3a7a33");
      }, 2200);
    }
  });

  // ---------- ANIMATED COUNTERS ----------
  /** @param {Element} node */
  function animateCounter(node){
    const el = /** @type {HTMLElement} */ (node);
    const raw = (el.textContent || "").trim();
    const prefix = raw.match(/^[#−-]/) ? raw[0] : "";
    const suffix = raw.match(/[×%×]$/) ? raw.slice(-1) : (raw.match(/[a-zA-Z]+$/) ? "" : "");
    const num = parseFloat(raw.replace(/[^0-9.]/g, ""));
    if (isNaN(num) || num === 0) return;

    const duration = 1200;
    const start = performance.now();
    const isInt = Number.isInteger(num);

    el.dataset.animated = "1";
    requestAnimationFrame(function frame(now){
      const t = Math.min(1, (now - start) / duration);
      const ease = 1 - Math.pow(1 - t, 3);
      const val = isInt ? Math.round(ease * num) : (ease * num).toFixed(1);
      el.textContent = prefix + val + suffix;
      if (t < 1) requestAnimationFrame(frame);
      else el.textContent = raw;
    });
  }

  const counterObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      e.target.querySelectorAll(".stat .value").forEach(node => {
        const el = /** @type {HTMLElement} */ (node);
        if (!el.dataset.animated) animateCounter(el);
      });
    });
  }, { threshold: 0.5 });
  document.querySelectorAll(".project").forEach(p => counterObs.observe(p));

  // ---------- PROJECT TABS ----------
  (function projectTabs(){
    const tabs   = document.querySelectorAll(".proj-tab");
    const panels = document.querySelectorAll(".projects-list");
    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        tabs.forEach(t => {
          const on = t === tab;
          t.classList.toggle("active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        panels.forEach(p => { p.hidden = p.dataset.panel !== target; });
      });
    });
  })();

  // ---------- SPARKLINE DRAW ANIMATION ----------
  (function animateSpark(){
    const line = /** @type {SVGPathElement | null} */ (document.getElementById("spark-line"));
    if (!line) return;
    const len = line.getTotalLength();
    line.style.strokeDasharray = len;
    line.style.strokeDashoffset = len;
    line.style.transition = "stroke-dashoffset 1.8s cubic-bezier(.4,0,.2,1) 0.3s";
    requestAnimationFrame(() => { line.style.strokeDashoffset = "0"; });
  })();

  // ---------- MAGNETIC CONTACT LINKS ----------
  document.querySelectorAll(".contact-link").forEach(node => {
    const el = /** @type {HTMLElement} */ (node);
    el.addEventListener("mousemove", ev => {
      const e = /** @type {MouseEvent} */ (ev);
      const r = el.getBoundingClientRect();
      const dx = (e.clientX - r.left - r.width  / 2) * 0.18;
      const dy = (e.clientY - r.top  - r.height / 2) * 0.18;
      el.style.transform = `translate(${dx}px, ${dy}px)`;
    });
    el.addEventListener("mouseleave", () => {
      el.style.transition = "transform 0.4s cubic-bezier(.2,.7,.2,1), background 0.2s";
      el.style.transform = "";
      setTimeout(() => { el.style.transition = ""; }, 400);
    });
  });

  // ---------- PAUSAR TIMERS CON LA PESTAÑA OCULTA (batería) ----------
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      if (scrambleInterval) { clearInterval(scrambleInterval); scrambleInterval = null; }
      if (clockTimer) { clearInterval(clockTimer); clockTimer = null; }
    } else {
      if (!clockTimer) { tick(); clockTimer = setInterval(tick, 1000); }
      if (!REDUCED_MOTION && !scrambleInterval) setupScramble();
    }
  });

  </script>
</body>
