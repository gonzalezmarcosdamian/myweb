          </div>
          <div class="now-meta">
            <div class="row"><span class="k">{t["now.role"]}</span><span class="v">{t["now.role.v"]}</span></div>
            <div class="row"><span class="k">{t["now.org"]}</span><span class="v">Ualá</span></div>
            <div class="row"><span class="k">{t["now.loc"]}</span><span class="v">Córdoba, AR</span></div>
