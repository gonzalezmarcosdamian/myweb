---
// Marcos Damián González — Personal Site (componente bilingüe: lang "es" | "en")
// Fuentes self-host (sin Google Fonts render-blocking): solo los pesos usados.
import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import { translations, type Lang } from '../i18n';

const { lang = 'es' } = Astro.props as { lang?: Lang };
const t = translations[lang];

const SITE = 'https://marcosdamiangonzalez.ar';
const isEn = lang === 'en';
const canonical = isEn ? `${SITE}/en/` : `${SITE}/`;
const title = isEn
  ? 'Marcos Damián González — Product Manager · Investing & Digital Banking'
  : 'Marcos Damián González — Product Manager · Inversiones & Banca Digital';
const description = isEn
  ? 'Product Manager with 6+ years leading investment and savings products in fintech and banking. Specialized in discovery, data and AI automation.'
  : 'Product Manager con +6 años liderando productos de inversión y ahorro en fintech y banca. Especializado en discovery, datos y automatización con IA.';
const ogDescription = isEn
  ? 'PM with 6+ years building investment and savings products in Argentine fintech and banking. Discovery, data and AI automation.'
  : 'PM con +6 años construyendo productos de inversión y ahorro en fintech y banca argentina. Discovery, datos y automatización con IA.';
const ogLocale = isEn ? 'en_US' : 'es_AR';
const ogLocaleAlt = isEn ? 'es_AR' : 'en_US';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Marcos Damián González" />
  <meta name="theme-color" content="#0a0a0a" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Marcos Damián González" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={ogLocaleAlt} />
  <meta property="og:image" content={`${SITE}/og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={`${SITE}/og.png`} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={`${SITE}/`} />
  <link rel="alternate" hreflang="en" href={`${SITE}/en/`} />
  <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Marcos Damián González",
    jobTitle: isEn ? "Product Manager · Investing & Digital Banking" : "Product Manager · Inversiones & Banca Digital",
    url: SITE + "/",
    image: `${SITE}/og.png`,
    address: { "@type": "PostalAddress", addressLocality: "Córdoba", addressCountry: "AR" },
    knowsLanguage: ["es", "en"],
    inLanguage: lang,
    sameAs: [
      "https://www.linkedin.com/in/marcosdamiangonzalez",
      "https://instagram.com/dagonzalz"
    ]
  })} />

  <!-- Fuentes self-host vía @fontsource (importadas en el frontmatter) -->


  <style>
    :root{
      --bg:        #0a0a0a;
      --bg-2:      #111111;
      --bg-3:      #161616;
      --line:      #1f1f1f;
      --line-2:    #2a2a2a;
      --fg:        #e7e5e0;
      --fg-dim:    #8a8a8a;
      --fg-mute:   #6a6a6a;
      --accent:    #76CE6B;
      --accent-dim:#3a7a33;
      --down:      #E0655D;
      --warm:      #E8E0D0;
      --grid:      rgba(255,255,255,0.025);

      --serif:  "Space Grotesk", sans-serif;
      --mono:   "JetBrains Mono", ui-monospace, monospace;
      --body:   "Inter", system-ui, sans-serif;

      --max:    1280px;
      --pad:    clamp(20px, 4vw, 64px);
    }

    *{ box-sizing: border-box; margin:0; padding:0; }
    html{ scroll-behavior: smooth; }
    body{
      font-family: var(--body);
      background: var(--bg);
      color: var(--fg);
      font-size: 16px;
      line-height: 1.55;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      font-variant-emoji: text; /* flechas/símbolos como texto, no emoji a color en mobile */
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 64px 64px;
      background-position: -1px -1px;
    }

    ::selection{ background: var(--accent); color: #000; }

    a{ color: inherit; text-decoration: none; }
    button{ background:none; border:none; color:inherit; font: inherit; cursor:pointer; }

    /* Foco visible para navegación por teclado (no afecta al mouse) */
    :focus-visible{
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 3px;
    }
    :focus:not(:focus-visible){ outline: none; }

    .wrap{
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--pad);
      position: relative;
    }

    /* ---------- NAV (empata con los sub-proyectos: barra sticky mono) ---------- */
    .nav{
      position: sticky; top: 0;
      z-index: 40;
      display: flex; align-items: center; gap: 4px;
      padding: 11px var(--pad);
      background: rgba(10,10,10,0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }
    .logo{
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      display: inline-flex; align-items: center; gap: 9px;
      color: var(--accent);
      flex: 0 0 auto;
    }
    /* punto de marca: se queda (guiño propio) pero estático, sin pulsar ni glow */
    .logo .dot{
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--accent);
      flex: 0 0 auto;
    }
    @keyframes pulse{
      0%,100%{ opacity: 1; transform: scale(1); }
      50%   { opacity: 0.68; transform: scale(0.9); }
    }

    .nav-sep{
      width: 1px; height: 14px; background: var(--line-2);
      margin: 0 8px; flex: 0 0 auto;
    }
    .nav-links{ display: flex; gap: 2px; }
    .nav-links a{
      font-family: var(--mono);
      font-size: 12px;
      color: var(--fg-dim);
      letter-spacing: 0.04em;
      padding: 5px 10px;
      border-radius: 6px;
      transition: color 0.2s, background 0.2s;
    }
    .nav-links a:hover{ color: var(--fg); background: var(--bg-3); }
    .nav-right{ display: flex; align-items: center; gap: 12px; margin-left: auto; flex: 0 0 auto; }

    .lang-toggle{
      display: inline-flex;
      border: 1px solid var(--line-2);
      border-radius: 999px;
      overflow: hidden;
      font-family: var(--mono);
      font-size: 11px;
    }
    .lang-toggle a{
      padding: 5px 11px;
      color: var(--fg-dim);
      letter-spacing: 0.04em;
      transition: all 0.2s;
    }
    .lang-toggle a.active{ background: var(--fg); color: var(--bg); }
    .lang-toggle a:not(.active):hover{ color: var(--fg); }

    .cv-btn{
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: var(--fg-dim);
      border: 1px solid var(--line-2);
      border-radius: 999px;
      padding: 5px 12px;
      white-space: nowrap;
      transition: color 0.2s, border-color 0.2s;
    }
    .cv-btn:hover{ color: var(--accent); border-color: var(--accent-dim); }

    @media (max-width: 720px){
      .nav-links, .nav-sep{ display: none; }
    }

    /* ---------- HERO ---------- */
    .hero{
      min-height: calc(100vh - 40px);
      padding-top: 48px;
      padding-bottom: 80px;
      display: flex; flex-direction: column; justify-content: center;
      position: relative;
    }

    .hero-meta{
      display: flex; align-items: center; gap: 16px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--fg-mute);
      letter-spacing: 0.08em;
      margin-bottom: 28px;
      text-transform: uppercase;
      flex-wrap: wrap;
    }
    .hero-meta .sep{ width: 30px; height: 1px; background: var(--line-2); }
    .status-pill{
      display: inline-flex; align-items: center; gap: 8px;
      padding: 4px 10px;
      border: 1px solid var(--accent-dim);
      border-radius: 999px;
      color: var(--accent);
      background: rgba(118,206,107,0.05);
    }
    .status-pill .dot{
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent);
      animation: pulse 2.4s ease-in-out infinite;
    }

    .hero h1{
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(48px, 8.4vw, 128px);
      line-height: 0.92;
      letter-spacing: -0.04em;
      margin-bottom: 36px;
    }
    .hero h1 .name{ display: block; }
    .hero h1 .role{
      display: block;
      color: var(--fg-mute);
      font-style: italic;
      font-weight: 300;
    }
    .scramble-wrap{
      font-family: var(--mono);
      font-size: clamp(20px, 2.8vw, 42px);
      font-weight: 600;
      color: var(--accent);
      letter-spacing: -0.02em;
      line-height: 1.15;
      min-height: 1.3em;
      margin-top: 4px;
      margin-bottom: 36px;
    }
    .scramble{ display: inline; }

    .hero-grid{
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 60px;
      align-items: end;
    }
    @media (max-width: 880px){
      .hero-grid{ grid-template-columns: 1fr; gap: 40px; }
    }
    .hero-left{ display: flex; flex-direction: column; align-items: flex-start; gap: 26px; }
    .hero-cta-btn{
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em;
      color: var(--bg); background: var(--accent);
      padding: 12px 22px; border-radius: 8px;
      transition: filter 0.2s, transform 0.2s;
    }
    .hero-cta-btn:hover{ filter: brightness(1.08); transform: translateY(-1px); }

    .hero-tagline{
      font-family: var(--body);
      font-size: clamp(15px, 1.6vw, 18px);
      line-height: 1.55;
      color: var(--fg-dim);
      max-width: 560px;
    }
    .hero-tagline em{
      color: var(--fg);
      font-style: normal;
      border-bottom: 1px dashed var(--accent-dim);
    }

    /* sparkline panel */
    .panel{
      border: 1px solid var(--line);
      background: rgba(17,17,17,0.6);
      backdrop-filter: blur(6px);
      padding: 18px 20px;
      position: relative;
    }
    .panel::before, .panel::after,
    .panel .corner-tr, .panel .corner-bl{
      content:"+";
      position: absolute;
      font-family: var(--mono);
      font-size: 10px;
      color: var(--accent);
      line-height: 1;
    }
    .panel::before{ top: -5px; left: -5px; }
    .panel::after{  bottom: -5px; right: -5px; }
    .panel .corner-tr{ top: -5px; right: -5px; }
    .panel .corner-bl{ bottom: -5px; left: -5px; }

    .panel-head{
      display: flex; justify-content: space-between; align-items: center;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--fg-mute);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .panel-head .live{ color: var(--accent); }

    .quote{
      display: flex; align-items: baseline; gap: 12px;
      margin-bottom: 12px;
      font-family: var(--mono);
    }
    .quote .symbol{ font-size: 13px; color: var(--fg); letter-spacing: 0.06em; }
    .quote .price{ font-size: 28px; font-weight: 500; color: var(--fg); font-variant-numeric: tabular-nums; }
    .quote .change{ font-size: 12px; color: var(--accent); font-variant-numeric: tabular-nums; }

    .spark{ width: 100%; height: 56px; display: block; }
    .spark-x{
      display: flex; justify-content: space-between;
      font-family: var(--mono); font-size: 9px;
      color: var(--fg-mute); margin-top: 4px;
      letter-spacing: 0.04em;
    }

    /* ---------- SECTIONS ---------- */
    section{ position: relative; padding: 120px 0; }
    .section-head{
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 24px;
      margin-bottom: 64px;
      align-items: baseline;
    }
    .section-num{
      font-family: var(--mono);
      font-size: 12px;
      color: var(--fg-mute);
      letter-spacing: 0.08em;
    }
    .section-title{
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(32px, 4vw, 56px);
      letter-spacing: -0.025em;
      line-height: 1.05;
    }
    .section-title em{
      color: var(--fg-mute);
      font-style: italic;
      font-weight: 300;
    }
    .section-sub{
      grid-column: 2 / -1;
      max-width: 600px;
      margin-top: 12px;
      color: var(--fg-dim);
      font-size: 15px;
    }

    /* ---------- SKILLS ---------- */
    .skills-grid{
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 24px;
    }
    .skill-group{
      grid-column: 2 / -1;
      border-top: 1px solid var(--line);
      padding: 28px 0;
      display: grid;
      grid-template-columns: 200px 1fr auto;
      gap: 32px;
      align-items: baseline;
      transition: padding 0.3s ease;
      cursor: default;
    }
    .skill-group:hover{ padding-left: 12px; }
    .skill-group:last-child{ border-bottom: 1px solid var(--line); }

    .skill-cat{
      font-family: var(--mono);
      font-size: 12px;
      color: var(--fg-mute);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: flex; align-items: baseline; gap: 10px;
    }
    .skill-cat .idx{ color: var(--accent); }

    .skill-list{
      display: flex; flex-wrap: wrap; gap: 8px 14px;
    }
    .skill{
      font-family: var(--body);
      font-size: 17px;
      color: var(--fg);
      position: relative;
      padding: 4px 0;
      cursor: default;
      transition: color 0.2s;
    }
    .skill::after{
      content: attr(data-w);
      font-family: var(--mono);
      font-size: 9px;
      color: var(--fg-mute);
      vertical-align: super;
      margin-left: 2px;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .skill:hover{ color: var(--accent); }
    .skill:hover::after{ opacity: 1; }

    .skill-meta{
      font-family: var(--mono);
      font-size: 11px;
      color: var(--fg-mute);
      letter-spacing: 0.06em;
      text-align: right;
      white-space: nowrap;
    }
    .skill-meta b{ color: var(--fg); font-weight: 500; }

    @media (max-width: 760px){
      .skill-group{ grid-template-columns: 1fr; gap: 12px; }
      .skill-meta{ text-align: left; }
    }

    /* ---------- PROJECTS ---------- */
    .projects{
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 24px;
    }
    .projects-col{ grid-column: 2 / -1; }
    .proj-tabs{
      display: flex;
      gap: 6px;
      margin-bottom: 20px;
    }
    .proj-tab{
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--fg-mute);
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 8px 16px;
      cursor: pointer;
      transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }
    .proj-tab:hover{ color: var(--fg); border-color: var(--line-2); }
    .proj-tab.active{
      color: var(--accent);
      border-color: var(--accent-dim);
      background: rgba(118,206,107,0.05);
    }
    .proj-tab .count{
      margin-left: 7px;
      color: var(--fg-mute);
      font-size: 10px;
    }
    .proj-tab.active .count{ color: var(--accent); }
    /* featured = proyectos propios, destacados aunque no estén activos */
    .proj-tab.featured{
      color: var(--fg);
      border-color: var(--accent-dim);
    }
    .proj-tab.featured:hover{ border-color: var(--accent); }
    .proj-tab .tab-dot{
      display: inline-block;
      width: 6px; height: 6px;
      margin-right: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 3px var(--accent);
      vertical-align: middle;
      animation: tabPulse 3s ease-in-out infinite;
    }
    @keyframes tabPulse{
      0%, 100%{ opacity: 1; transform: scale(1); }
      50%{ opacity: 0.6; transform: scale(0.9); }
    }
    @media (prefers-reduced-motion: reduce){
      .proj-tab .tab-dot{ animation: none; }
    }
    .projects-list{
      display: grid;
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
    }
    .projects-list[hidden]{ display: none; }
    .project{
      background: var(--bg);
      padding: 32px 28px;
      display: grid;
      grid-template-columns: 1.5fr 2fr 1fr;
      gap: 32px;
      align-items: start;
      position: relative;
      transition: background 0.3s ease;
      cursor: default;
    }
    .project::before{
      content: ""; position: absolute; left: 0; top: 0; bottom: 0;
      width: 2px; background: var(--accent);
      transform: scaleY(0); transform-origin: bottom;
      transition: transform 0.4s ease;
    }
    .project:hover{ background: var(--bg-2); }
    .project:hover::before{ transform: scaleY(1); transform-origin: top; }

    .project-head{
      display: flex; flex-direction: column; gap: 6px;
    }
    .project-symbol{
      font-family: var(--mono);
      font-size: 11px;
      color: var(--fg-mute);
      letter-spacing: 0.08em;
      display: flex; align-items: center; gap: 10px;
    }
    .project-symbol .badge{
      padding: 2px 6px;
      border: 1px solid var(--line-2);
      color: var(--fg-dim);
      border-radius: 3px;
      font-size: 9px;
    }
    .project-symbol .badge.live{
      color: var(--accent);
      border-color: var(--accent-dim);
      background: rgba(118,206,107,0.05);
    }
    .project-name{
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 500;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }
    .project-org{
      font-family: var(--mono);
      font-size: 11px;
      color: var(--fg-mute);
      letter-spacing: 0.04em;
      margin-top: 2px;
    }

    .project-desc{
      color: var(--fg-dim);
      font-size: 14.5px;
      line-height: 1.55;
      max-width: 460px;
    }
    .project-desc em{ color: var(--fg); font-style: normal; }

    .project-stats{
      display: flex; flex-direction: column; gap: 14px;
      align-items: flex-end;
      text-align: right;
    }
    .stat{ font-family: var(--mono); }
    .stat .label{
      font-size: 10px;
      color: var(--fg-mute);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 2px;
    }
    .stat .value{
      font-size: 22px;
      color: var(--accent);
      font-weight: 500;
      font-variant-numeric: tabular-nums;
    }
    .stat .value.neutral{ color: var(--fg); }

    @media (max-width: 880px){
      .project{ grid-template-columns: 1fr; gap: 20px; }
      .project-stats{ flex-direction: row; align-items: flex-start; text-align: left; gap: 28px; }
    }

    /* ---------- NOW SECTION ---------- */
    .now{
      background: var(--bg-2);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 80px 0;
      margin: 60px 0;
    }
    .now-grid{
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 24px;
    }
    .now-content{
      grid-column: 2 / -1;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 60px;
      align-items: start;
    }
    @media (max-width: 760px){
      .now-content{ grid-template-columns: 1fr; gap: 32px; }
    }
    .now-label{
      font-family: var(--mono);
      font-size: 11px;
      color: var(--accent);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 16px;
    }
    .now-label .dot{
      width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
      animation: pulse 2.4s ease-in-out infinite;
    }
    .now-text{
      font-family: var(--serif);
      font-size: clamp(22px, 2.6vw, 30px);
      line-height: 1.3;
      letter-spacing: -0.015em;
      font-weight: 400;
    }
    .now-text em{ color: var(--accent); font-style: normal; }

    .now-meta{
      font-family: var(--mono);
      font-size: 12px;
      color: var(--fg-dim);
      line-height: 1.7;
      letter-spacing: 0.02em;
    }
    .now-meta .row{
      display: flex; justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px dashed var(--line);
    }
    .now-meta .row:last-child{ border-bottom: none; }
    .now-meta .k{ color: var(--fg-mute); }
    .now-meta .v{ color: var(--fg); }

    /* ---------- CONTACT ---------- */
    .contact{ padding: 120px 0 100px; }
    .contact-grid{
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 24px;
    }
    .contact-main{ grid-column: 2 / -1; }
    .contact-cta{
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(40px, 6vw, 88px);
      line-height: 0.95;
      letter-spacing: -0.035em;
      margin-bottom: 56px;
    }
    .contact-cta em{
      color: var(--fg-mute);
      font-style: italic;
      font-weight: 300;
    }
    .contact-cta a{
      color: var(--accent);
      position: relative;
      display: inline-block;
    }
    .contact-cta a::after{
      content: ""; position: absolute; left: 0; right: 0; bottom: 0.06em;
      height: 1px; background: var(--accent);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.4s cubic-bezier(.7,0,.3,1);
    }
    .contact-cta a:hover::after{ transform: scaleX(1); }

    .contact-links{
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .contact-link{
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 10px;
      width: 60px; height: 60px;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.2s, border-color 0.2s;
      position: relative;
    }
    .contact-link:hover{ background: var(--bg-2); border-color: var(--accent-dim); }
    .contact-link .ico{
      width: 22px; height: 22px;
      stroke: var(--fg-dim); fill: none; stroke-width: 1.6;
      transition: stroke 0.2s, fill 0.2s;
      flex: 0 0 auto;
    }
    .contact-link .ico.fill{ fill: var(--fg-dim); stroke: none; }
    .contact-link:hover .ico{ stroke: var(--accent); }
    .contact-link:hover .ico.fill{ fill: var(--accent); stroke: none; }

    /* ---------- FOOTER ---------- */
    footer{
      border-top: 1px solid var(--line);
      padding: 32px var(--pad);
      margin-top: 60px;
      display: flex; justify-content: space-between; align-items: center;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--fg-mute);
      letter-spacing: 0.04em;
      flex-wrap: wrap;
      gap: 12px;
    }
    footer .clock{ color: var(--fg-dim); font-variant-numeric: tabular-nums; }

    /* ---------- REVEAL ---------- */
    .reveal{
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.9s cubic-bezier(.2,.7,.2,1), transform 0.9s cubic-bezier(.2,.7,.2,1);
    }
    .reveal.in{ opacity: 1; transform: none; }


    /* ---------- GLITCH ---------- */
    @keyframes glitch-1{
      0%,94%,100%{ clip-path: none; transform: none; }
      95%{ clip-path: inset(20% 0 50% 0); transform: translateX(-3px); color: var(--down); }
      96%{ clip-path: inset(60% 0 10% 0); transform: translateX(3px); color: var(--accent); }
      97%{ clip-path: inset(40% 0 30% 0); transform: translateX(-2px); }
      98%{ clip-path: none; transform: none; color: inherit; }
    }
    @keyframes glitch-2{
      0%,96%,100%{ opacity: 0; }
      95%{ opacity: 1; transform: translateX(4px); color: var(--accent); }
      97%{ opacity: 1; transform: translateX(-4px); color: var(--down); }
      98%{ opacity: 0; }
    }
    .glitch{ position: relative; display: inline-block; }
    .glitch::before, .glitch::after{
      content: attr(data-text);
      position: absolute; left: 0; top: 0;
      font: inherit; color: inherit;
      pointer-events: none;
    }
    .glitch::before{ animation: glitch-1 20s steps(1) infinite; }
    .glitch::after{ animation: glitch-2 20s steps(1) infinite; opacity: 0; }

    /* ---------- TYPING CURSOR ---------- */
    .scramble-wrap::after{
      display: inline;
      content: "▋";
      font-family: var(--mono);
      color: var(--accent);
      animation: blink 1s step-end infinite;
      margin-left: 2px;
      font-size: 0.85em;
    }
    @keyframes blink{
      0%,100%{ opacity: 1; }
      50%{ opacity: 0; }
    }

    /* ---------- MAGNETIC CONTACT ---------- */
    .contact-link{ will-change: transform; }

    @media (prefers-reduced-motion: reduce){
      *{ animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }

    @media (max-width: 600px){
      section{ padding: 72px 0; }

      .scramble-wrap{ font-size: clamp(16px, 5vw, 24px); margin-bottom: 24px; }

      .section-head{
        grid-template-columns: 1fr;
        gap: 8px;
        margin-bottom: 40px;
      }
      .section-num{ display: none; }
      .section-sub{ grid-column: 1 / -1; }

      .skills-grid{ grid-template-columns: 1fr; }
      .skill-group{ grid-column: 1 / -1; }

      .projects{ grid-template-columns: 1fr; }
      .projects-col{ grid-column: 1 / -1; }

      .now-grid{ grid-template-columns: 1fr; }
      .now-content{ grid-column: 1 / -1; }

      .contact-grid{ grid-template-columns: 1fr; }
      .contact-main{ grid-column: 1 / -1; }
      .contact-cta{ font-size: clamp(32px, 10vw, 56px); margin-bottom: 32px; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
